---
import Base from "../../layouts/Base.astro";
import { AllowedRoutes } from "../../route";
import Breadcrumbs from "../../components/common/Breadcrumbs.astro";
import { Image } from "astro:assets";
import ProfileImage from "../../assets/images/profile-image.jpg";
import InterestBarhCard from "../../components/card/InterestBarhCard";
import MacintoshInterfaceCard from "../../components/card/MacintoshInterfaceCard";
import { SiPioneerdj } from "solid-icons/si";
import { BiSolidCoffeeAlt, BiSolidTerminal } from "solid-icons/bi";
import { ImHeadphones } from "solid-icons/im";
import GitHubContributionsCard from "../../components/card/GitHubContributionsCard";
import WorkCard from "../../components/card/WorkCard";

import {
	SiGnubash,
	SiPerl,
	SiPython,
	SiJupyter,
	SiAnaconda,
	SiScikitlearn,
	SiPandas,
	SiNumpy,
	SiScipy,
	SiPytorch,
	SiPyg,
	SiStreamlit,
	SiR,
	SiHtml5,
	SiCss,
	SiSass,
	SiTailwindcss,
	SiMarkdown,
	SiLatex,
	SiLua,
	SiJavascript,
	SiTypescript,
	SiNodedotjs,
	SiNpm,
	SiJquery,
	SiVuedotjs,
	SiSolid,
	SiNuxt,
	SiAstro,
	SiGsap,
	SiThreedotjs,
	SiLaravel,
	SiGit,
	SiGithub,
	SiCloudflare,
	SiVercel,
	SiGoogleappsscript,
	SiVim,
	SiClaude,
	SiMacos,
} from "solid-icons/si";
import { BsOpenai, BsWindows } from "solid-icons/bs";
import { VsVscode, VsMcp } from "solid-icons/vs";

const routes = new AllowedRoutes(Astro.url.pathname);
const { meta } = routes.getSubsetPageMeta();

// GitHub API
const githubContribRes = await fetch(
	`${Astro.url.origin}/api/github-contributions`,
);
const gitHubCalendar = await githubContribRes.json();

// skills
const skills = [
	{ label: "計算化学", value: 80 },
	{ label: "統計・機械学習", value: 80 },
	{ label: "Web", value: 60 },
	{ label: "有機化学", value: 50 },
	{ label: "IT インフラ", value: 20 },
];

const softwares = [
	{
		name: "Bash",
		Icon: SiGnubash,
		link: "https://www.gnu.org/software/bash/",
	},
	{
		name: "Perl",
		Icon: SiPerl,
		link: "https://www.perl.org/",
	},
	{
		name: "Python",
		Icon: SiPython,
		link: "https://www.python.org/",
	},
	{
		name: "Jupyter",
		Icon: SiJupyter,
		link: "https://jupyter.org/",
	},
	{
		name: "Anaconda",
		Icon: SiAnaconda,
		link: "https://www.anaconda.com/",
	},
	{
		name: "NumPy",
		Icon: SiNumpy,
		link: "https://numpy.org/ja/",
	},
	{
		name: "Pandas",
		Icon: SiPandas,
		link: "https://pandas.pydata.org/",
	},
	{
		name: "SciPy",
		Icon: SiScipy,
		link: "https://scipy.org/ja/",
	},
	{
		name: "scikit-learn",
		Icon: SiScikitlearn,
		link: "https://scikit-learn.org/",
	},
	{
		name: "PyTorch",
		Icon: SiPytorch,
		link: "https://pytorch.org/",
	},
	{
		name: "PyG",
		Icon: SiPyg,
		link: "https://pytorch-geometric.readthedocs.io/",
	},
	{
		name: "Streamlit",
		Icon: SiStreamlit,
		link: "https://streamlit.io/",
	},
	{
		name: "R",
		Icon: SiR,
		link: "https://www.r-project.org/",
	},
	{
		name: "HTML5",
		Icon: SiHtml5,
		link: "https://www.w3.org/",
	},
	{
		name: "CSS3",
		Icon: SiCss,
		link: "https://www.w3.org/",
	},
	{
		name: "Sass",
		Icon: SiSass,
		link: "https://sass-lang.com/",
	},
	{
		name: "Tailwind CSS",
		Icon: SiTailwindcss,
		link: "https://tailwindcss.com/",
	},
	{
		name: "Markdown",
		Icon: SiMarkdown,
		link: "https://daringfireball.net/projects/markdown/",
	},
	{
		name: "LaTeX",
		Icon: SiLatex,
		link: "https://www.latex-project.org/",
	},
	{
		name: "Lua",
		Icon: SiLua,
		link: "https://www.lua.org/",
	},
	{
		name: "JavaScript",
		Icon: SiJavascript,
		link: "https://ecma-international.org/",
	},
	{
		name: "TypeScript",
		Icon: SiTypescript,
		link: "https://www.typescriptlang.org/ja/",
	},
	{
		name: "Node.js",
		Icon: SiNodedotjs,
		link: "https://nodejs.org/ja",
	},
	{
		name: "NPM",
		Icon: SiNpm,
		link: "https://www.npmjs.com",
	},
	{
		name: "jQuery",
		Icon: SiJquery,
		link: "https://jquery.com/",
	},
	{
		name: "Vue.js",
		Icon: SiVuedotjs,
		link: "https://ja.vuejs.org/",
	},
	{
		name: "SolidJS",
		Icon: SiSolid,
		link: "https://www.solidjs.com/",
	},
	{
		name: "Nuxt",
