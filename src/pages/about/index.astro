		Icon: SiThreedotjs,
		link: "https://threejs.org/",
	},
	{
		name: "Laravel",
		Icon: SiLaravel,
		link: "https://laravel.com/",
	},
	{
		name: "Git",
		Icon: SiGit,
		link: "https://git-scm.com/",
	},
	{
		name: "GitHub",
		Icon: SiGithub,
		link: "https://github.com/",
	},
	{
		name: "Cloudflare",
		Icon: SiCloudflare,
		link: "https://cloudflare.com/",
	},
	{
		name: "Vercel",
		Icon: SiVercel,
		link: "https://vercel.com/",
	},
	{
		name: "Google Apps Script",
		Icon: SiGoogleappsscript,
		link: "https://developers.google.com/apps-script?hl=ja",
	},
	{
		name: "Vim",
		Icon: SiVim,
		link: "https://www.vim.org/",
	},
	{
		name: "Visual Studio Code",
		Icon: VsVscode,
		link: "https://code.visualstudio.com/",
	},
	{
		name: "ChatGPT",
		Icon: BsOpenai,
		link: "https://chatgpt.com/",
	},
	{
		name: "Claude",
		Icon: SiClaude,
		link: "https://claude.ai/",
	},
	{
		name: "MCP",
		Icon: VsMcp,
		link: "https://modelcontextprotocol.io/",
	},
	{
		name: "Microsoft Windows",
		Icon: BsWindows,
		link: "https://www.microsoft.com/ja-jp/windows",
	},
	{
		name: "macOS",
		Icon: SiMacos,
		link: "https://www.apple.com/os/macos/",
	},
];

// publications
const author_me = "S. Inoue";
const publications = [
	{
		authors: ["D. Tauchi", "S. Inoue", "M. Hasegawa"],
		et_al: true,
		title: "Structure and chiroptical properties of platinum(II) complexes with chiral BINOL ligands",
		year: 2025,
		journal: "Chemistry Letters",
		volume: "54",
		page: "upaf140",
		link: "https://doi.org/10.1093/chemle/upaf140",
	},
	{
		authors: ["T. Seki", "Y. Shinozaki", "S. Inoue", "G. Watanabe"],
		et_al: true,
		title: "Machine learning-based prediction of molecular packing in organic semiconductors",
		year: 2026,
		journal: "Chemistry Letters",
		volume: "55",
		page: "upag066",
		link: "https://doi.org/10.1093/chemle/upag066",
	},
];

// presentations
const presentations = [
	{
		authors: ["S. Inoue", "G. Watanabe"],
		et_al: true,
		title: "スパースモデリングを用いた有機半導体における隣接分子間の二面角予測",
		year: 2025,
		month: "September",
		conference: "The 86th JSAP Autumn Meeting",
		place: "Aichi, Japan",
		type: "Poster",
		link: "https://pub.confit.atlas.jp/ja/event/jsap2025a/presentation/7p-P04-6",
	},
	{
		authors: ["S. Inoue", "G. Watanabe"],
		et_al: true,
		title: "機械学習による有機半導体結晶の隣接分子間の二面角予測",
		year: 2025,
		month: "October",
		conference: "15th CSJ Chemistry Festa",
		place: "Tokyo, Japan",
		type: "Poster",
		link: "https://festa.csj.jp/2025/program/#ps-P3",
	},
];

// qualifications
const qualifications = [
	{ name: "普通自動車第一種運転免許", year: 2023, month: "March" },
	{ name: "統計検定 2級", year: 2023, month: "December" },
];

// works
const works = [
	{
		title: "SIWL.dev",
		description: "テックブログ & ポートフォリオ",
		github_url: "https://github.com/s-inoue0108/siwl-dev",
		keywords: ["Astro", "Tech blog"],
	},
	{
		title: "CHIROpy",
		description:
			"Gaussian 量子化学計算によるキラル光学特性解析のためのバインディングツール",
		github_url: "https://github.com/s-inoue0108/chiropy",
		keywords: ["量子化学", "OLED"],
	},
	{
		title: "smiles2mol",
		description: "化学構造の文字列表現から3次元配座を生成する CLI ツール",
		github_url: "https://github.com/s-inoue0108/smiles2mol",
		keywords: ["Python", "マテインフォ"],
	},
	{
		title: "Chemref MCP",
		description:
			"化学論文を AI から検索するための MCP による API ラッパー実装",
		github_url: "https://github.com/s-inoue0108/chemref-mcp",
		keywords: ["MCP", "化学"],
	},
];
---

<Base
	title={`${meta.name} | ${import.meta.env.APP_NAME}`}
	description=`${meta.description}`
>
	<section class="pt-8 w-full flex flex-col gap-8">
		<Breadcrumbs />
		<h1 class="flex justify-center text-4xl lg:text-6xl font-extrabold">
			{meta.name}
		</h1>
		<div class="w-full flex flex-col xl:flex-row gap-16 justify-between">
			<div class="w-full xl:w-[40%] flex flex-col gap-8 items-center">
				<MacintoshInterfaceCard title="$ whoami" client:visible>
					<div
						class="flex flex-col justify-between xl:justify-center gap-4"
					>
						<ul class="flex justify-center items-center gap-8">
							<li class="w-20 h-20 lg:w-28 lg:h-28">
								<Image
									src={ProfileImage}
									alt="Profile Image"
									class="border-2 border-muted-background w-full h-full object-cover rounded-full"
								/>
							</li>
							<li>
								<h3 class="text-2xl lg:text-4xl font-bold">
									{import.meta.env.APP_OWNER}
								</h3>
								<p
									class="text-sm lg:text-base text-muted-foreground"
								>
									{import.meta.env.APP_OWNER_ROLE}
								</p>
							</li>
						</ul>
						<ul class="flex justify-center items-center gap-6">
							<li class="flex flex-col text-muted-foreground">
								<h3
									class="font-code whitespace-nowrap text-center text-sm lg:text-base italic font-semibold"
								>
									// Likes
								</h3>
								<ul class="mt-2 flex gap-4 items-center">
									<li
										class="text-3xl lg:text-4xl"
										title="Caffeine"
									>
										<BiSolidCoffeeAlt />
									</li>
									<li
										class="text-3xl lg:text-4xl"
										title="Coding"
									>
										<BiSolidTerminal />
									</li>
									<li
										class="text-2xl lg:text-3xl"
										title="Electronic Dance Music"
									>
										<ImHeadphones />
									</li>
								</ul>
							</li>
							<li>
								<div
									class="relative
										w-20
										h-20
										lg:w-24
										lg:h-24
										border-4
										border-accent-sub-base
										object-cover
										rounded-full
										text-accent-sub-base"
								>
									<p
										class="text-center absolute top-[20%] left-1/2 -translate-x-1/2 text-3xl lg:text-4xl font-extrabold whitespace-nowrap"
									>
										<SiPioneerdj />
									</p>
									<p
										class="text-center absolute top-[60%] left-1/2 -translate-x-1/2 text-[0.6rem] lg:text-xs whitespace-nowrap"
									>
										DDJ-FLX4
									</p>
								</div>
							</li>
							<li>
								<div
									class="relative
										w-20
										h-20
										lg:w-24
										lg:h-24
										border-4
										border-accent-base
										object-cover
										rounded-full
										text-accent-base"
								>
									<p
										class="text-center absolute top-[20%] left-1/2 -translate-x-1/2 text-xl lg:text-2xl font-extrabold whitespace-nowrap"
									>
										INTP
									</p>
									<p
										class="text-center absolute top-[60%] left-1/2 -translate-x-1/2 text-[0.6rem] lg:text-xs whitespace-nowrap"
									>
										Logician
									</p>
								</div>
							</li>
						</ul>
					</div>
				</MacintoshInterfaceCard>
				<MacintoshInterfaceCard
					title="$ stat skills.dat"
					client:visible
				>
					<InterestBarhCard data={skills} />
					<div
						class="my-4 border-b border-muted-background w-full rounded-lg"
					>
					</div>
					<h3
						class="font-code text-muted-foreground text-sm lg:text-base italic font-semibold"
					>
						&lt;!--Software Experience--&gt;
					</h3>
					<ul class="mt-4 mb-2 flex flex-wrap gap-3 items-center">
						{
							softwares.map((item) => {
								return (
									<li class="text-muted-foreground text-2xl xl:text-3xl">
										<a
											href={item.link}
											title={item.name}
											target="_blank"
											rel="noopener noreferrer"
											class="hover:text-foreground transition duration-150"
										>
											<item.Icon />
										</a>
									</li>
								);
							})
						}
					</ul>
				</MacintoshInterfaceCard>
			</div>
			<ul class="w-full xl:w-[60%] flex flex-col gap-16">
				<li class="w-full">
					<GitHubContributionsCard
						calendar={gitHubCalendar}
						githubUsername={import.meta.env.GITHUB_USERNAME}
						githubUrl={import.meta.env.GITHUB_URL}
						client:load
					/>
				</li>
				<hr class="border border-muted-background w-full rounded-lg" />
				<h3 class="text-left text-3xl font-bold">Works</h3>
				<ul class="w-full flex flex-wrap items-center gap-6">
					{
						works.map((work) => (
							<li class="basis-full sm:basis-[calc(50%-1.5rem)] md:basis-[calc(33.333%-1.5rem)] xl:basis-[calc(50%-1.5rem)] 2xl:basis-[calc(33.333%-1.5rem)]">
								<WorkCard work={work} client:visible />
							</li>
						))
					}
				</ul>
				<hr class="border border-muted-background w-full rounded-lg" />
				<h3 class="text-left text-3xl font-bold">
					Publications & Presentations
				</h3>
				<ol class="flex flex-col gap-6 list-decimal list-outside pl-6">
					{
						publications.map((item) => {
							return (
								<li class="text-xl">
									<a
										href={item.link}
										target="_blank"
										rel="noopener noreferrer"
										class="hover:opacity-70 transition duration-150"
									>
										<span>
											{item.authors.map((author, i) => (
												<span>
													{i > 0 && ", "}
													{author === author_me ? (
														<strong class="text-accent-base font-bold underline">
															{author}
														</strong>
													) : (
														author
													)}
												</span>
											))}
										</span>
										{item.et_al ? <i>et al.</i> : ""},
										{item.title}, <i>{item.journal}</i>{" "}
										<strong>({item.volume})</strong>,{" "}
										{item.page} ({item.year}).
									</a>
								</li>
							);
						})
					}
					{
						presentations.map((item) => {
							return (
								<li class="text-xl">
									<a
										href={item.link}
										target="_blank"
										rel="noopener noreferrer"
										class="hover:opacity-70 transition duration-150"
									>
										<span>
											{item.authors.map((author, i) => (
												<span>
													{i > 0 && ", "}
													{author === author_me ? (
														<strong class="text-accent-base font-bold underline">
															{author}
														</strong>
													) : (
														author
													)}
												</span>
											))}
										</span>
										{item.et_al ? <i>et al.</i> : ""},
										{item.title}, <i>{item.conference}</i>,{" "}
										{item.place}, {item.month} {item.year}.{" "}
										({item.type})
									</a>
								</li>
							);
						})
					}
				</ol>
				<hr class="border border-muted-background w-full rounded-lg" />
				<h3 class="text-left text-3xl font-bold">Qualifications</h3>
				<ul class="flex flex-col gap-6">
					{
						qualifications.map((item) => {
							return (
								<li class="flex flex-col md:flex-row gap-0 md:gap-4 text-xl">
									<p class="min-w-64">{item.name}</p>
									<p>
										({item.month} {item.year})
									</p>
								</li>
							);
						})
					}
				</ul>
			</ul>
		</div>
	</section>
</Base>
