---
import Base from "../layouts/Base.astro";
import { AllowedRoutes } from "../route";
import Breadcrumbs from "../components/common/Breadcrumbs.astro";
import { Image } from "astro:assets";
import ProfileImage from "../assets/images/profile-image.jpg";
import InterestBarhCard from "../components/card/InterestBarhCard";
import MacintoshInterfaceCard from "../components/card/MacintoshInterfaceCard";
import { SiPioneerdj } from "solid-icons/si";
import { BiSolidCoffeeAlt, BiSolidTerminal } from "solid-icons/bi";
import { ImHeadphones } from "solid-icons/im";
import GitHubContributionsCard from "../components/card/GitHubContributionsCard";
import WorkCard from "../components/card/WorkCard";

const routes = new AllowedRoutes(Astro.url.pathname);
const { meta } = routes.getSubsetPageMeta();

// GitHub GraphQL API をたたく
const today = new Date();
const to = new Date(
	today.getFullYear(),
	today.getMonth(),
	today.getDate(),
	23,
	59,
	59,
).toISOString();
const fromDate = new Date(today);
fromDate.setFullYear(fromDate.getFullYear() - 1);
fromDate.setDate(fromDate.getDate() + 2);
fromDate.setHours(0, 0, 0, 0);
const from = fromDate.toISOString();

const response = await fetch("https://api.github.com/graphql", {
	method: "POST",
	headers: {
		"Content-Type": "application/json",
		Authorization: `Bearer ${import.meta.env.GITHUB_ACCESS_TOKEN}`,
	},
	body: JSON.stringify({
		query: `
			query($user: String!, $from: DateTime!, $to: DateTime!) {
				user(login: $user){
					contributionsCollection(from: $from, to: $to) {
						contributionCalendar {
							totalContributions
							weeks {
								contributionDays {
									contributionCount
									date
								}
							}
						}
					}
				}
			}
		`,
		variables: {
			user: import.meta.env.GITHUB_USERNAME,
			from: from,
			to: to,
		},
	}),
});

const gitHubContributions = await response.json();
const gitHubCalendar =
	gitHubContributions.data.user.contributionsCollection.contributionCalendar;

// skills
const skills = [
	{ label: "Materials Informatics", value: 90 },
	{ label: "Chemistry", value: 80 },
	{ label: "Statistics", value: 70 },
	{ label: "Web", value: 50 },
	{ label: "Networks", value: 10 },
];

// publications
const author_me = "S. Inoue";
const publications = [
	{
		authors: ["D. Tauchi", "S. Inoue", "M. Hasegawa"],
		et_al: true,
		title: "Structure and chiroptical properties of platinum(II) complexes with chiral BINOL ligands",
		year: 2025,
		journal: "Chemistry Letters",
		volume: "54",
		page: "upaf140",
		link: "https://doi.org/10.1093/chemle/upaf140",
	},
	{
		authors: ["T. Seki", "Y. Shinozaki", "S. Inoue", "G. Watanabe"],
		et_al: true,
		title: "Machine learning-based prediction of molecular packing in organic semiconductors",
		year: 2026,
		journal: "Chemistry Letters",
		volume: "55",
		page: "upag066",
		link: "https://doi.org/10.1093/chemle/upag066",
	},
];

// presentations
const presentations = [
	{
		authors: ["S. Inoue", "G. Watanabe"],
		et_al: true,
		title: "スパースモデリングを用いた有機半導体における隣接分子間の二面角予測",
		year: 2025,
		month: "September",
		conference: "The 86th JSAP Autumn Meeting",
		place: "Aichi, Japan",
		type: "Poster",
		link: "https://pub.confit.atlas.jp/ja/event/jsap2025a/presentation/7p-P04-6",
	},
	{
		authors: ["S. Inoue", "G. Watanabe"],
		et_al: true,
		title: "機械学習による有機半導体結晶の隣接分子間の二面角予測",
		year: 2025,
		month: "October",
		conference: "15th CSJ Chemistry Festa",
		place: "Tokyo, Japan",
		type: "Poster",
		link: "https://festa.csj.jp/2025/program/#ps-P3",
	},
];

// qualifications
const qualifications = [
	{ name: "普通自動車第一種運転免許", year: 2023, month: "March" },
	{ name: "統計検定 2級", year: 2023, month: "December" },
];

// works
const works = [
	{
		title: "SIWL.dev",
		description: "テックブログ & ポートフォリオ",
		github_url: "https://github.com/s-inoue0108/siwl-dev",
		keywords: ["Astro", "Tech blog", "Portfolio"],
	},
	{
		title: "CHIROpy",
		description:
			"Gaussian 量子化学計算によるキラル光学特性解析のためのバインディングツール",
		github_url: "https://github.com/s-inoue0108/chiropy",
		keywords: ["量子化学", "OLED"],
	},
	{
		title: "smiles2mol",
		description: "SMILES表現から3次元化学構造を生成する CLI ツール",
		github_url: "https://github.com/s-inoue0108/smiles2mol",
		keywords: ["マテインフォ", "化学"],
	},
];
---

<Base
	title={`${meta.name} | ${import.meta.env.APP_NAME}`}
	description=`${meta.description}`
>
	<section class="pt-8 w-full flex flex-col gap-8">
		<Breadcrumbs />
		<h1 class="flex justify-center text-4xl lg:text-6xl font-extrabold">
			{meta.name}
		</h1>
		<div class="w-full flex flex-col xl:flex-row gap-16 justify-between">
			<div class="w-full xl:w-[40%] flex flex-col gap-8 items-center">
				<MacintoshInterfaceCard title="$ whoami">
					<div
						class="flex flex-col justify-between xl:justify-center gap-4"
					>
						<ul class="flex justify-center items-center gap-8">
							<li class="w-28 h-28">
								<Image
									src={ProfileImage}
									alt="Profile Image"
									class="border-2 border-muted-background w-full h-full object-cover rounded-full"
								/>
							</li>
							<li>
								<h3 class="text-4xl font-bold">
									{import.meta.env.APP_OWNER}
								</h3>
								<p class="text-base text-muted-foreground">
									{import.meta.env.APP_OWNER_ROLE}
								</p>
							</li>
						</ul>
						<ul class="flex justify-center items-center gap-6">
							<li class="flex flex-col text-muted-foreground">
								<h3 class="text-center text-lg font-semibold">
									# what-i-love
								</h3>
								<ul class="mt-2 flex gap-4 items-center">
									<li class="text-4xl">
										<BiSolidCoffeeAlt />
									</li>
									<li class="text-4xl">
										<BiSolidTerminal />
									</li>
									<li class="text-3xl">
										<ImHeadphones />
									</li>
								</ul>
							</li>
							<li>
								<div
									class="relative
										w-24
										h-24
										border-4
										border-accent-sub-base
										object-cover
										rounded-full
										text-accent-sub-base"
								>
									<p
										class="text-center absolute top-[20%] left-1/2 -translate-x-1/2 text-4xl font-extrabold whitespace-nowrap"
									>
										<SiPioneerdj />
									</p>
									<p
										class="text-center absolute top-[60%] left-1/2 -translate-x-1/2 text-xs whitespace-nowrap"
									>
										DDJ-FLX4
									</p>
								</div>
							</li>
							<li>
								<div
									class="relative
										w-24
										h-24
										border-4
										border-accent-base
										object-cover
										rounded-full
										text-accent-base"
								>
									<p
										class="text-center absolute top-[20%] left-1/2 -translate-x-1/2 text-2xl font-extrabold whitespace-nowrap"
									>
										INTP
									</p>
									<p
										class="text-center absolute top-[60%] left-1/2 -translate-x-1/2 text-xs whitespace-nowrap"
									>
										Logician
									</p>
								</div>
							</li>
						</ul>
					</div>
				</MacintoshInterfaceCard>
				<MacintoshInterfaceCard title="$ stat skills.dat">
					<InterestBarhCard data={skills} />
				</MacintoshInterfaceCard>
			</div>
			<ul class="w-full xl:w-[60%] flex flex-col gap-16">
				<li class="w-full">
					<GitHubContributionsCard
						calendar={gitHubCalendar}
						githubUsername={import.meta.env.GITHUB_USERNAME}
						githubUrl={import.meta.env.GITHUB_URL}
						client:load
					/>
				</li>
				<hr class="border border-muted-background w-full rounded-lg" />
				<h3 class="text-left text-muted-foreground text-3xl font-bold">
					Works
				</h3>
				<ul class="flex items-center gap-6">
					{
						works.map((work) => (
							<li class="w-1/3">
								<WorkCard work={work} client:visible />
							</li>
						))
					}
				</ul>
				<hr class="border border-muted-background w-full rounded-lg" />
				<h3 class="text-left text-muted-foreground text-3xl font-bold">
					Publications & Presentations
				</h3>
				<ol class="flex flex-col gap-6 list-decimal list-outside pl-6">
					{
						publications.map((item) => {
							return (
								<li class="text-muted-foreground text-xl">
									<a
										href={item.link}
										target="_blank"
										rel="noopener noreferrer"
										class="hover:opacity-70 transition duration-150"
									>
										<span>
											{item.authors.map((author, i) => (
												<span>
													{i > 0 && ", "}
													{author === author_me ? (
														<strong class="text-accent-base font-bold underline">
															{author}
														</strong>
													) : (
														author
													)}
												</span>
											))}
										</span>
										{item.et_al ? <i>et al.</i> : ""},
										{item.title}, <i>{item.journal}</i>{" "}
										<strong>({item.volume})</strong>,{" "}
										{item.page} ({item.year}).
									</a>
								</li>
							);
						})
					}
					{
						presentations.map((item) => {
							return (
								<li class="text-muted-foreground text-xl">
									<a
										href={item.link}
										target="_blank"
										rel="noopener noreferrer"
										class="hover:opacity-70 transition duration-150"
									>
										<span>
											{item.authors.map((author, i) => (
												<span>
													{i > 0 && ", "}
													{author === author_me ? (
														<strong class="text-accent-base font-bold underline">
															{author}
														</strong>
													) : (
														author
													)}
												</span>
											))}
										</span>
										{item.et_al ? <i>et al.</i> : ""},
										{item.title}, <i>{item.conference}</i>,{" "}
										{item.place}, {item.month} {item.year}.{" "}
										({item.type})
									</a>
								</li>
							);
						})
					}
				</ol>
				<hr class="border border-muted-background w-full rounded-lg" />
				<h3 class="text-left text-muted-foreground text-3xl font-bold">
					Qualifications
				</h3>
				<ul class="flex flex-col gap-6">
					{
						qualifications.map((item) => {
							return (
								<li class="flex gap-8 text-muted-foreground text-xl">
									<p class="min-w-64">{item.name}</p>
									<p>
										({item.month} {item.year})
									</p>
								</li>
							);
						})
					}
				</ul>
			</ul>
		</div>
	</section>
</Base>
